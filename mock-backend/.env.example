# ---- Required ----
# At least 32 random characters.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of the FRONTEND (Stripe success/cancel redirects go back here)
APP_URL=http://localhost:3000

# ---- Stripe (leave empty to run in local MOCK payment mode) ----
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Mock payments are on automatically in `npm run dev` when STRIPE_SECRET_KEY is empty.
ALLOW_MOCK_PAYMENTS=false

# ---- Email (receipt PDF). Empty SMTP_HOST -> written to .data/outbox/ ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus Corporate Services <billing@nexus-corp.example>"

SEED_DEMO_DATA=true
